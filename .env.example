# Local development only. Shared engine configuration stays per deployment.
PROJECT_NAME=woodroom
POSTGRES_DB=grey_tapes
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
COLLECTION_POLICY=source_stream
# Only initial local-preservation setup uses these reviewed byte limits.
MEDIA_BUDGET=0
MEDIA_RESERVE=0
# For the optional development override, point at a canonical Arkhiv checkout.
# ARKHIV_CORE_SOURCE=/absolute/path/to/arkhiv
# Import/correction/manifest inputs, mounted read-only into operator containers.
IMPORT_ROOT=./data/imports
# Explicit approval notes for the optional private source playback review worker.
# PLAYBACK_REVIEW_NOTES=Owner approved private streaming of supported public DJ Screw Discography audio.

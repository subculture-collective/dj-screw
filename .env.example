# Local development only. Shared engine configuration stays per deployment.
PROJECT_NAME=woodroom
POSTGRES_DB=grey_tapes
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
# Self-hosted audio (ADR 0004). MEDIA_ROOT holds
# dj-screw-discography-local/<identifier>/<file>; fill it with
# scripts/mirror_audio.py. The byte budget covers that folder; the reserve is
# free space the volume must keep.
MEDIA_ROOT=./data/media
MEDIA_BUDGET=2147483648
MEDIA_RESERVE=1073741824
# For the optional development override, point at a canonical Arkhiv checkout.
# ARKHIV_CORE_SOURCE=/absolute/path/to/arkhiv
# Import/correction/manifest inputs, mounted read-only into operator containers.
IMPORT_ROOT=./data/imports
# Explicit approval notes for the optional private source playback review worker.
# PLAYBACK_REVIEW_NOTES=Owner approved self-hosted playback of verified DJ Screw Discography originals.
# Checksum receipt under IMPORT_ROOT, written by Arkhiv's scripts/source_audio_receipt.py.
# RECOVERY_RECEIPT=receipt.json
